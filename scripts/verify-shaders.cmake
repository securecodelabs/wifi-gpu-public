file(STRINGS "${ROOT}/kernels/checksums.sha256" checksums)
list(LENGTH checksums count)
if(NOT count EQUAL 2)
    message(FATAL_ERROR "Invalid shader checksum manifest")
endif()
set(expected pbkdf2.comp pbkdf2.spv)
foreach(i RANGE 0 1)
    list(GET checksums ${i} entry)
    list(GET expected ${i} name)
    if(NOT entry MATCHES "^([a-f0-9]+)  (pbkdf2\\.(comp|spv))$")
        message(FATAL_ERROR "Invalid shader checksum entry")
    endif()
    set(digest "${CMAKE_MATCH_1}")
    if(NOT "${CMAKE_MATCH_2}" STREQUAL "${name}")
        message(FATAL_ERROR "Invalid shader checksum filename")
    endif()
    file(SHA256 "${ROOT}/kernels/${name}" actual)
    if(NOT "${actual}" STREQUAL "${digest}")
        message(FATAL_ERROR "Shader source/binary mismatch: ${name}. Run scripts/compile-shaders.ps1.")
    endif()
endforeach()

    } else if(phase==1) {
        Digest ip=Digest(state_words[state_index(id,0u+0)],state_words[state_index(id,0u+1)],state_words[state_index(id,0u+2)],state_words[state_index(id,0u+3)],state_words[state_index(id,0u+4)]);
        Digest op=Digest(state_words[state_index(id,5u+0)],state_words[state_index(id,5u+1)],state_words[state_index(id,5u+2)],state_words[state_index(id,5u+3)],state_words[state_index(id,5u+4)]);
        Digest u=Digest(state_words[state_index(id,10u+0)],state_words[state_index(id,10u+1)],state_words[state_index(id,10u+2)],state_words[state_index(id,10u+3)],state_words[state_index(id,10u+4)]);
        Digest acc=Digest(state_words[state_index(id,15u+0)],state_words[state_index(id,15u+1)],state_words[state_index(id,15u+2)],state_words[state_index(id,15u+3)],state_words[state_index(id,15u+4)]);
        // Separate inner/outer bodies keep the pad states fixed and remove
        // the per-compression branch from the hot loop.
        uint inner_first=sha1_first_round(ip),outer_first=sha1_first_round(op);
        [[dont_unroll]] for(uint step=0;step<p.rounds;++step) {
            u=sha1_20(ip,u,inner_first); u=sha1_20(op,u,outer_first);
            acc.a^=u.a; acc.b^=u.b; acc.c^=u.c; acc.d^=u.d; acc.e^=u.e;
        }
        state_words[state_index(id,10u+0)]=u.a;
        state_words[state_index(id,10u+1)]=u.b;
        state_words[state_index(id,10u+2)]=u.c;
        state_words[state_index(id,10u+3)]=u.d;
        state_words[state_index(id,10u+4)]=u.e;
        state_words[state_index(id,15u+0)]=acc.a;
        state_words[state_index(id,15u+1)]=acc.b;
        state_words[state_index(id,15u+2)]=acc.c;
        state_words[state_index(id,15u+3)]=acc.d;
        state_words[state_index(id,15u+4)]=acc.e;
    } else {
        for(uint i=0;i<(block==0?5u:3u);++i) pmks[candidate*8+block*5+i]=state_words[state_index(id,15u+i)];
    }
}
